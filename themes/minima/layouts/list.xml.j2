<?xml version="1.0" encoding="utf-8" standalone="yes"?>
{#- RSS for the home page, sections and terms. -#}
{% if page.home %}{% set items = site.regular_pages %}{% else %}{% set items = page.regular_pages %}{% endif %}
{% set limit = site.params.rss_limit | default(20) %}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{% if page.home %}{{ site.title }}{% else %}{{ page.title }} on {{ site.title }}{% endif %}</title>
    <link>{{ page.permalink }}</link>
    <description>Recent content {% if not page.home %}in {{ page.title }} {% endif %}on {{ site.title }}</description>
    {% if site.params.copyright %}<copyright>{{ site.params.copyright }}</copyright>{% endif %}
    <atom:link href="{{ page.permalink }}index.xml" rel="self" type="application/rss+xml" />
    {% for item in items | selectattr("date") | sort(attribute="date", reverse=true) %}
    {% if loop.index <= limit %}
    <item>
      <title>{{ item.title }}</title>
      <link>{{ item.permalink }}</link>
      <pubDate>{{ item.date | date("%a, %d %b %Y %H:%M:%S +0000") }}</pubDate>
      <guid>{{ item.permalink }}</guid>
      <description>{{ item.summary }}</description>
    </item>
    {% endif %}
    {% endfor %}
  </channel>
</rss>
